# AdvisorFlow AI Environment Variables
# Copy this file to .env.local and fill in your values

# Required: Your OpenAI API key
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: OpenAI model (defaults to gpt-4o-mini in the API route)
# OPENAI_MODEL=gpt-4o-mini

# PayFast Payment Gateway (South Africa)
# Get these from https://www.payfast.co.za after registering
# For sandbox testing: NEXT_PUBLIC_PAYFAST_SANDBOX=true
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your_merchant_id
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=your_merchant_key
NEXT_PUBLIC_PAYFAST_SANDBOX=true
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app